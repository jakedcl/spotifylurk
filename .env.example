# Public Spotify client id. No client secret — login uses Authorization Code + PKCE.
SPOTIFY_CLIENT_ID=0d0442af4a834e45ba7596d442ca3a9d

# Must match a redirect URI in the Spotify dashboard exactly. Use 127.0.0.1, not localhost.
# Production (Vercel project spotifylurk): https://spotifylurk.vercel.app/api/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3847/api/auth/callback

# Neon direct connection string, or local Postgres.
DATABASE_URL=postgres://pile:pile@127.0.0.1:5432/pile

# Encrypts Spotify refresh and access tokens at rest. Any long random string, or 32 bytes of base64.
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-string

# Signs the httpOnly session cookie.
SESSION_SECRET=replace-with-a-different-long-random-string

# Optional. Chat returns a clear error until this is set.
OPENAI_API_KEY=

# Cheap default. Override if you want another model.
OPENAI_MODEL=gpt-4o-mini

# Development only. Lets you open the seeded sample library without Spotify.
# Ignored when NODE_ENV=production.
DEV_PREVIEW=true
